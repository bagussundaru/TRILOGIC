import React, { useState, useRef, useEffect } from 'react';
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { ScrollArea } from "@/components/ui/scroll-area";
import { base44 } from '@/api/base44Client';
import { 
  Sparkles, 
  Send, 
  Loader2, 
  Bot, 
  User,
  Lightbulb,
  BarChart3,
  FileText,
  AlertTriangle
} from "lucide-react";
import { motion, AnimatePresence } from "framer-motion";

export default function AIChatPanel({ implementations, tasks, risks }) {
  const [messages, setMessages] = useState([
    {
      role: 'assistant',
      content: 'Halo! Saya AI Assistant untuk Smart TRILOGIC. Saya bisa membantu Anda menganalisis proyek, memberikan insight, dan menjawab pertanyaan seputar implementasi. Silakan tanya apa saja!'
    }
  ]);
  const [input, setInput] = useState('');
  const [isLoading, setIsLoading] = useState(false);
  const scrollRef = useRef(null);

  const quickPrompts = [
    { icon: BarChart3, text: 'Analisis status proyek', prompt: 'Berikan analisis singkat tentang status semua proyek yang sedang berjalan' },
    { icon: AlertTriangle, text: 'Proyek berisiko', prompt: 'Proyek mana yang berisiko tinggi dan butuh perhatian segera?' },
    { icon: FileText, text: 'Ringkasan mingguan', prompt: 'Buat ringkasan mingguan untuk PMO meeting' },
    { icon: Lightbulb, text: 'Rekomendasi prioritas', prompt: 'Berikan rekomendasi prioritas untuk tim minggu ini' },
  ];

  useEffect(() => {
    if (scrollRef.current) {
      scrollRef.current.scrollTop = scrollRef.current.scrollHeight;
    }
  }, [messages]);

  const buildContext = () => {
    const activeProjects = implementations.filter(i => i.status !== 'Completed' && i.status !== 'Cancelled');
    const atRiskProjects = implementations.filter(i => i.health_status === 'At Risk' || i.health_status === 'Critical');
    const completedTasks = tasks.filter(t => t.status === 'Done').length;
    const openRisks = risks.filter(r => r.status === 'Open' || r.status === 'Mitigating');

    return `
Context Data Smart TRILOGIC:
- Total proyek aktif: ${activeProjects.length}
- Proyek berisiko: ${atRiskProjects.length}
- Total tasks: ${tasks.length} (${completedTasks} selesai)
- Risiko terbuka: ${openRisks.length}

Detail Proyek Aktif:
${activeProjects.slice(0, 5).map(p => `- ${p.project_code}: ${p.project_name} (Status: ${p.status}, Health: ${p.health_status || 'On Track'}, Progress: ${p.progress_percentage || 0}%)`).join('\n')}

Proyek Berisiko:
${atRiskProjects.map(p => `- ${p.project_code}: ${p.project_name} - ${p.health_status}`).join('\n') || 'Tidak ada'}

Risiko Terbuka:
${openRisks.slice(0, 5).map(r => `- ${r.risk_title} (Impact: ${r.impact}, Probability: ${r.probability})`).join('\n') || 'Tidak ada risiko terbuka'}
    `;
  };

  const sendMessage = async (messageText) => {
    if (!messageText.trim() || isLoading) return;

    const userMessage = { role: 'user', content: messageText };
    setMessages(prev => [...prev, userMessage]);
    setInput('');
    setIsLoading(true);

    try {
      const context = buildContext();
      const response = await base44.integrations.Core.InvokeLLM({
        prompt: `Anda adalah AI Assistant untuk Smart TRILOGIC. Tugas Anda adalah membantu menganalisis proyek implementasi, memberikan insight, dan menjawab pertanyaan tentang status proyek.

${context}

Pertanyaan user: ${messageText}

Berikan jawaban yang helpful, actionable, dan dalam bahasa Indonesia. Jika diminta analisis, berikan insight yang specific berdasarkan data di atas. Format jawaban dengan jelas menggunakan bullet points atau numbering jika perlu.`,
      });

      const assistantMessage = { role: 'assistant', content: response };
      setMessages(prev => [...prev, assistantMessage]);
    } catch (error) {
      const errorMessage = { role: 'assistant', content: 'Maaf, terjadi kesalahan saat memproses permintaan Anda. Silakan coba lagi.' };
      setMessages(prev => [...prev, errorMessage]);
    } finally {
      setIsLoading(false);
    }
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    sendMessage(input);
  };

  return (
    <Card className="border-0 shadow-sm h-full flex flex-col">
      <CardHeader className="pb-3 border-b">
        <CardTitle className="text-lg font-semibold text-gray-800 flex items-center gap-2">
          <Sparkles className="w-5 h-5 text-teal-600" />
          AI Assistant
        </CardTitle>
      </CardHeader>
      
      <CardContent className="flex-1 flex flex-col p-0">
        {/* Messages */}
        <ScrollArea className="flex-1 p-4" ref={scrollRef}>
          <div className="space-y-4">
            <AnimatePresence>
              {messages.map((message, index) => (
                <motion.div
                  key={index}
                  initial={{ opacity: 0, y: 10 }}
                  animate={{ opacity: 1, y: 0 }}
                  className={`flex gap-3 ${message.role === 'user' ? 'justify-end' : ''}`}
                >
                  {message.role === 'assistant' && (
                    <div className="w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center flex-shrink-0">
                      <Bot className="w-4 h-4 text-teal-600" />
                    </div>
                  )}
                  <div 
                    className={`max-w-[85%] rounded-2xl px-4 py-3 ${
                      message.role === 'user' 
                        ? 'bg-teal-600 text-white' 
                        : 'bg-gray-100 text-gray-800'
                    }`}
                  >
                    <p className="text-sm whitespace-pre-wrap">{message.content}</p>
                  </div>
                  {message.role === 'user' && (
                    <div className="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center flex-shrink-0">
                      <User className="w-4 h-4 text-gray-600" />
                    </div>
                  )}
                </motion.div>
              ))}
            </AnimatePresence>
            
            {isLoading && (
              <motion.div
                initial={{ opacity: 0 }}
                animate={{ opacity: 1 }}
                className="flex gap-3"
              >
                <div className="w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center">
                  <Bot className="w-4 h-4 text-teal-600" />
                </div>
                <div className="bg-gray-100 rounded-2xl px-4 py-3">
                  <Loader2 className="w-4 h-4 animate-spin text-gray-500" />
                </div>
              </motion.div>
            )}
          </div>
        </ScrollArea>

        {/* Quick Prompts */}
        {messages.length <= 2 && (
          <div className="px-4 pb-3">
            <p className="text-xs text-gray-500 mb-2">Pertanyaan cepat:</p>
            <div className="flex flex-wrap gap-2">
              {quickPrompts.map((prompt, index) => (
                <Button
                  key={index}
                  variant="outline"
                  size="sm"
                  className="text-xs h-8"
                  onClick={() => sendMessage(prompt.prompt)}
                  disabled={isLoading}
                >
                  <prompt.icon className="w-3 h-3 mr-1" />
                  {prompt.text}
                </Button>
              ))}
            </div>
          </div>
        )}

        {/* Input */}
        <form onSubmit={handleSubmit} className="p-4 border-t bg-gray-50">
          <div className="flex gap-2">
            <Input
              value={input}
              onChange={(e) => setInput(e.target.value)}
              placeholder="Tanya sesuatu tentang proyek..."
              disabled={isLoading}
              className="flex-1"
            />
            <Button 
              type="submit" 
              disabled={isLoading || !input.trim()}
              className="bg-teal-600 hover:bg-teal-700"
            >
              {isLoading ? (
                <Loader2 className="w-4 h-4 animate-spin" />
              ) : (
                <Send className="w-4 h-4" />
              )}
            </Button>
          </div>
        </form>
      </CardContent>
    </Card>
  );
}