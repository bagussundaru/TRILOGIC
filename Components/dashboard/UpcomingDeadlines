import React from 'react';
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { format, differenceInDays, isPast } from 'date-fns';
import { Calendar, Clock, AlertCircle } from "lucide-react";
import { motion } from "framer-motion";

export default function UpcomingDeadlines({ implementations, tasks }) {
  // Combine implementations and tasks with due dates
  const deadlines = [
    ...implementations
      .filter(i => i.target_end_date && i.status !== 'Completed' && i.status !== 'Cancelled')
      .map(i => ({
        id: i.id,
        title: i.project_name,
        type: 'Project',
        date: i.target_end_date,
        status: i.status,
        priority: i.priority
      })),
    ...tasks
      .filter(t => t.due_date && t.status !== 'Done')
      .map(t => ({
        id: t.id,
        title: t.task_name,
        type: 'Task',
        date: t.due_date,
        status: t.status,
        priority: t.priority
      }))
  ]
    .sort((a, b) => new Date(a.date) - new Date(b.date))
    .slice(0, 6);

  const getDaysUntil = (date) => {
    const days = differenceInDays(new Date(date), new Date());
    if (days < 0) return { text: `${Math.abs(days)}d overdue`, color: 'text-red-600 bg-red-50' };
    if (days === 0) return { text: 'Due today', color: 'text-orange-600 bg-orange-50' };
    if (days <= 3) return { text: `${days}d left`, color: 'text-amber-600 bg-amber-50' };
    if (days <= 7) return { text: `${days}d left`, color: 'text-blue-600 bg-blue-50' };
    return { text: `${days}d left`, color: 'text-gray-600 bg-gray-50' };
  };

  const priorityColors = {
    'Low': 'bg-gray-100 text-gray-700',
    'Medium': 'bg-blue-100 text-blue-700',
    'High': 'bg-orange-100 text-orange-700',
    'Critical': 'bg-red-100 text-red-700',
    'Urgent': 'bg-red-100 text-red-700',
  };

  return (
    <motion.div
      initial={{ opacity: 0, x: -20 }}
      animate={{ opacity: 1, x: 0 }}
      transition={{ duration: 0.4, delay: 0.5 }}
    >
      <Card className="border-0 shadow-sm h-full">
        <CardHeader className="pb-3">
          <CardTitle className="text-lg font-semibold text-gray-800 flex items-center gap-2">
            <Calendar className="w-5 h-5 text-teal-600" />
            Upcoming Deadlines
          </CardTitle>
        </CardHeader>
        <CardContent className="pt-0">
          {deadlines.length > 0 ? (
            <div className="space-y-3 max-h-[320px] overflow-y-auto pr-2">
              {deadlines.map((item, index) => {
                const daysInfo = getDaysUntil(item.date);
                const isOverdue = isPast(new Date(item.date));
                return (
                  <div 
                    key={item.id || index} 
                    className={`p-3 rounded-lg border ${isOverdue ? 'border-red-200 bg-red-50/50' : 'border-gray-100 bg-gray-50/50'} hover:bg-gray-100 transition-colors`}
                  >
                    <div className="flex items-start justify-between gap-2">
                      <div className="flex-1 min-w-0">
                        <p className="font-medium text-gray-800 text-sm truncate">{item.title}</p>
                        <div className="flex items-center gap-2 mt-1">
                          <Badge variant="outline" className="text-xs px-2 py-0">
                            {item.type}
                          </Badge>
                          <Badge className={`text-xs px-2 py-0 ${priorityColors[item.priority] || priorityColors['Medium']}`}>
                            {item.priority}
                          </Badge>
                        </div>
                      </div>
                      <div className="text-right">
                        <span className={`text-xs font-medium px-2 py-1 rounded ${daysInfo.color}`}>
                          {daysInfo.text}
                        </span>
                        <p className="text-xs text-gray-400 mt-1">
                          {format(new Date(item.date), 'MMM d')}
                        </p>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          ) : (
            <div className="flex flex-col items-center justify-center h-[200px] text-gray-400">
              <Clock className="w-10 h-10 mb-2" />
              <p className="text-sm">No upcoming deadlines</p>
            </div>
          )}
        </CardContent>
      </Card>
    </motion.div>
  );
}