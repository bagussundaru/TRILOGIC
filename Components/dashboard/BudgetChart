import React from 'react';
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer, Legend, CartesianGrid } from 'recharts';
import { motion } from "framer-motion";

export default function BudgetChart({ implementations }) {
    // Group by region and calculate budget
    const regionData = implementations.reduce((acc, impl) => {
        const region = impl.customer_region || 'Other';
        if (!acc[region]) {
            acc[region] = { allocated: 0, spent: 0 };
        }
        acc[region].allocated += impl.budget_allocated || 0;
        acc[region].spent += impl.budget_spent || 0;
        return acc;
    }, {});

    const data = Object.entries(regionData)
        .map(([region, values]) => ({
            region: region.length > 12 ? region.substring(0, 12) + '...' : region,
            fullRegion: region,
            allocated: Math.round(values.allocated / 1000000), // Convert to millions
            spent: Math.round(values.spent / 1000000),
        }))
        .sort((a, b) => b.allocated - a.allocated)
        .slice(0, 6);

    const CustomTooltip = ({ active, payload, label }) => {
        if (active && payload && payload.length) {
            const item = data.find(d => d.region === label);
            return (
                <div className="bg-white px-4 py-3 shadow-lg rounded-lg border">
                    <p className="font-semibold text-gray-800 mb-2">{item?.fullRegion || label}</p>
                    <p className="text-sm text-blue-600">Allocated: Rp {payload[0]?.value}M</p>
                    <p className="text-sm text-emerald-600">Spent: Rp {payload[1]?.value}M</p>
                </div>
            );
        }
        return null;
    };

    return (
        <motion.div
            initial={{ opacity: 0, scale: 0.95 }}
            animate={{ opacity: 1, scale: 1 }}
            transition={{ duration: 0.4, delay: 0.3 }}
        >
            <Card className="border-0 shadow-sm">
                <CardHeader className="pb-2">
                    <CardTitle className="text-lg font-semibold text-gray-800">Budget by Region (in Millions IDR)</CardTitle>
                </CardHeader>
                <CardContent>
                    {data.length > 0 ? (
                        <ResponsiveContainer width="100%" height={280}>
                            <BarChart data={data} margin={{ top: 10, right: 10, left: -10, bottom: 0 }}>
                                <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                                <XAxis
                                    dataKey="region"
                                    tick={{ fontSize: 11, fill: '#6b7280' }}
                                    axisLine={{ stroke: '#e5e7eb' }}
                                />
                                <YAxis
                                    tick={{ fontSize: 11, fill: '#6b7280' }}
                                    axisLine={{ stroke: '#e5e7eb' }}
                                />
                                <Tooltip content={<CustomTooltip />} />
                                <Legend
                                    wrapperStyle={{ paddingTop: 10 }}
                                    formatter={(value) => <span className="text-sm text-gray-600 capitalize">{value}</span>}
                                />
                                <Bar dataKey="allocated" fill="#3b82f6" radius={[4, 4, 0, 0]} name="Allocated" />
                                <Bar dataKey="spent" fill="#10b981" radius={[4, 4, 0, 0]} name="Spent" />
                            </BarChart>
                        </ResponsiveContainer>
                    ) : (
                        <div className="h-[280px] flex items-center justify-center text-gray-400">
                            No budget data available
                        </div>
                    )}
                </CardContent>
            </Card>
        </motion.div>
    );
}