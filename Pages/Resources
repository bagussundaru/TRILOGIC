import React, { useState } from 'react';
import { base44 } from '@/api/base44Client';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { Button } from "@/components/ui/button";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import {
    Plus,
    Users,
    BarChart3,
    Grid3x3,
    Loader2,
    UserPlus
} from "lucide-react";
import { motion } from "framer-motion";

import ResourceTable from '../components/resources/ResourceTable';
import ResourceForm from '../components/resources/ResourceForm';
import CapacityPlanning from '../components/resources/CapacityPlanning';
import SkillMatrix from '../components/resources/SkillMatrix';
import AllocationForm from '../components/resources/AllocationForm';

export default function Resources() {
    const [view, setView] = useState('list');
    const [resourceFormOpen, setResourceFormOpen] = useState(false);
    const [allocationFormOpen, setAllocationFormOpen] = useState(false);
    const [editingResource, setEditingResource] = useState(null);

    const queryClient = useQueryClient();

    const { data: resources = [], isLoading: loadingResources } = useQuery({
        queryKey: ['resources'],
        queryFn: () => base44.entities.Resource.list('-created_date'),
    });

    const { data: allocations = [], isLoading: loadingAllocations } = useQuery({
        queryKey: ['allocations'],
        queryFn: () => base44.entities.ResourceAllocation.list('-created_date'),
    });

    const { data: implementations = [] } = useQuery({
        queryKey: ['implementations'],
        queryFn: () => base44.entities.Implementation.list('-created_date'),
    });

    const createResourceMutation = useMutation({
        mutationFn: (data) => base44.entities.Resource.create(data),
        onSuccess: () => {
            queryClient.invalidateQueries({ queryKey: ['resources'] });
            setResourceFormOpen(false);
            setEditingResource(null);
            base44.entities.ActivityLog.create({
                action_type: 'Created',
                entity_type: 'Resource',
                description: 'New resource added to team',
            });
        },
    });

    const updateResourceMutation = useMutation({
        mutationFn: ({ id, data }) => base44.entities.Resource.update(id, data),
        onSuccess: () => {
            queryClient.invalidateQueries({ queryKey: ['resources'] });
            setResourceFormOpen(false);
            setEditingResource(null);
        },
    });

    const createAllocationMutation = useMutation({
        mutationFn: (data) => base44.entities.ResourceAllocation.create(data),
        onSuccess: async (newAllocation) => {
            queryClient.invalidateQueries({ queryKey: ['allocations'] });
            setAllocationFormOpen(false);

            // Update resource utilization
            const resource = resources.find(r => r.id === newAllocation.resource_id);
            if (resource) {
                const resourceAllocations = allocations.filter(
                    a => a.resource_id === resource.id && a.status === 'Active'
                );
                const totalUtilization = resourceAllocations.reduce(
                    (sum, a) => sum + (a.allocation_percentage || 0),
                    0
                ) + (newAllocation.allocation_percentage || 0);

                await base44.entities.Resource.update(resource.id, {
                    current_utilization: Math.min(totalUtilization, 150),
                });
                queryClient.invalidateQueries({ queryKey: ['resources'] });
            }
        },
    });

    const handleEditResource = (resource) => {
        setEditingResource(resource);
        setResourceFormOpen(true);
    };

    const handleSaveResource = (data) => {
        if (editingResource) {
            updateResourceMutation.mutate({ id: editingResource.id, data });
        } else {
            createResourceMutation.mutate(data);
        }
    };

    const handleCloseResourceForm = () => {
        setResourceFormOpen(false);
        setEditingResource(null);
    };

    const isLoading = loadingResources || loadingAllocations;

    if (isLoading) {
        return (
            <div className= "min-h-screen flex items-center justify-center bg-gray-50" >
            <div className="text-center" >
                <Loader2 className="w-8 h-8 animate-spin text-teal-600 mx-auto mb-4" />
                    <p className="text-gray-500" > Loading resources...</p>
                        </div>
                        </div>
    );
    }

    return (
        <div className= "min-h-screen bg-gray-50/50 p-6" >
        <div className="max-w-7xl mx-auto space-y-6" >
            {/* Header */ }
            < motion.div
    initial = {{ opacity: 0, y: -20 }
}
animate = {{ opacity: 1, y: 0 }}
className = "flex flex-col sm:flex-row sm:items-center justify-between gap-4"
    >
    <div>
    <h1 className="text-3xl font-bold text-gray-900" > Resource Management </h1>
        < p className = "text-gray-500 mt-1" > Team capacity, skills, and allocation tracking </p>
            </div>
            < div className = "flex items-center gap-3" >
                <Button 
              onClick={ () => setAllocationFormOpen(true) }
variant = "outline"
className = "gap-2"
    >
    <UserPlus className="w-4 h-4" />
        Allocate Resource
            </Button>
            < Button
onClick = {() => setResourceFormOpen(true)}
className = "gap-2 bg-teal-600 hover:bg-teal-700"
    >
    <Plus className="w-4 h-4" />
        Add Resource
            </Button>
            </div>
            </motion.div>

{/* Summary Stats */ }
<div className="grid grid-cols-1 sm:grid-cols-4 gap-4" >
    <motion.div
            initial={ { opacity: 0, y: 20 } }
animate = {{ opacity: 1, y: 0 }}
transition = {{ delay: 0.1 }}
className = "bg-white p-6 rounded-xl shadow-sm border border-gray-100"
    >
    <div className="flex items-center justify-between" >
        <div>
        <p className="text-sm text-gray-500" > Total Resources </p>
            < p className = "text-2xl font-bold text-gray-900 mt-1" > { resources.length } </p>
                </div>
                < div className = "p-3 rounded-lg bg-teal-50" >
                    <Users className="w-5 h-5 text-teal-600" />
                        </div>
                        </div>
                        </motion.div>

                        < motion.div
initial = {{ opacity: 0, y: 20 }}
animate = {{ opacity: 1, y: 0 }}
transition = {{ delay: 0.2 }}
className = "bg-white p-6 rounded-xl shadow-sm border border-gray-100"
    >
    <div className="flex items-center justify-between" >
        <div>
        <p className="text-sm text-gray-500" > Available </p>
            < p className = "text-2xl font-bold text-gray-900 mt-1" >
                { resources.filter(r => r.status === 'Available').length }
                </p>
                </div>
                < div className = "p-3 rounded-lg bg-emerald-50" >
                    <Users className="w-5 h-5 text-emerald-600" />
                        </div>
                        </div>
                        </motion.div>

                        < motion.div
initial = {{ opacity: 0, y: 20 }}
animate = {{ opacity: 1, y: 0 }}
transition = {{ delay: 0.3 }}
className = "bg-white p-6 rounded-xl shadow-sm border border-gray-100"
    >
    <div className="flex items-center justify-between" >
        <div>
        <p className="text-sm text-gray-500" > Active Allocations </p>
            < p className = "text-2xl font-bold text-gray-900 mt-1" >
                { allocations.filter(a => a.status === 'Active').length }
                </p>
                </div>
                < div className = "p-3 rounded-lg bg-blue-50" >
                    <BarChart3 className="w-5 h-5 text-blue-600" />
                        </div>
                        </div>
                        </motion.div>

                        < motion.div
initial = {{ opacity: 0, y: 20 }}
animate = {{ opacity: 1, y: 0 }}
transition = {{ delay: 0.4 }}
className = "bg-white p-6 rounded-xl shadow-sm border border-gray-100"
    >
    <div className="flex items-center justify-between" >
        <div>
        <p className="text-sm text-gray-500" > Unique Skills </p>
            < p className = "text-2xl font-bold text-gray-900 mt-1" >
                { [...new Set(resources.flatMap(r => r.skills || []))].length }
                </p>
                </div>
                < div className = "p-3 rounded-lg bg-purple-50" >
                    <Grid3x3 className="w-5 h-5 text-purple-600" />
                        </div>
                        </div>
                        </motion.div>
                        </div>

{/* View Tabs */ }
<Tabs value={ view } onValueChange = { setView } className = "w-full" >
    <TabsList className="bg-white shadow-sm border" >
        <TabsTrigger value="list" className = "gap-2" >
            <Users className="w-4 h-4" />
                Team List
                    </TabsTrigger>
                    < TabsTrigger value = "capacity" className = "gap-2" >
                        <BarChart3 className="w-4 h-4" />
                            Capacity Planning
                                </TabsTrigger>
                                < TabsTrigger value = "skills" className = "gap-2" >
                                    <Grid3x3 className="w-4 h-4" />
                                        Skills Matrix
                                            </TabsTrigger>
                                            </TabsList>

                                            < TabsContent value = "list" className = "mt-6" >
                                                <ResourceTable 
              resources={ resources }
onEdit = { handleEditResource }
    />
    </TabsContent>

    < TabsContent value = "capacity" className = "mt-6" >
        <CapacityPlanning 
              resources={ resources }
allocations = { allocations }
    />
    </TabsContent>

    < TabsContent value = "skills" className = "mt-6" >
        <SkillMatrix resources={ resources } />
            </TabsContent>
            </Tabs>

{/* Resource Form */ }
<ResourceForm
          resource={ editingResource }
open = { resourceFormOpen }
onClose = { handleCloseResourceForm }
onSave = { handleSaveResource }
isLoading = { createResourceMutation.isPending || updateResourceMutation.isPending }
    />

    {/* Allocation Form */ }
    < AllocationForm
resources = { resources }
implementations = { implementations }
open = { allocationFormOpen }
onClose = {() => setAllocationFormOpen(false)}
onSave = {(data) => createAllocationMutation.mutate(data)}
isLoading = { createAllocationMutation.isPending }
    />
    </div>
    </div>
  );
}